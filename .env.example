# Copy file này thành .env.local (bỏ .example) rồi điền giá trị thật
# Lấy 2 giá trị này tại: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://fnxmrpelwrlbqigrpbrd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dán-anon-public-key-ở-đây

# Khi deploy thật, thêm đúng 2 biến này (tên y hệt, có tiền tố NEXT_PUBLIC_)
# vào Vercel → Project Settings → Environment Variables, rồi deploy lại.

# ----- Paddle (thanh toán) -----
# Client-side token: Paddle Dashboard → Developer Tools → Authentication → tab "Client-side tokens"
# → "New client-side token". Token này CHẠY ĐƯỢC trong trình duyệt (không phải bí mật như API key
# thường) nhưng vẫn tách riêng theo môi trường: sandbox token bắt đầu bằng "test_", live token bắt
# đầu bằng "live_" — dùng ĐÚNG cặp token/environment, không trộn lẫn.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=dán-client-side-token-ở-đây

# Chỉ nhận "sandbox" hoặc "production" — cố tình KHÔNG có giá trị mặc định trong code, để không
# lỡ chạy nhầm sang tài khoản Paddle khác khi quên set biến này.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
